/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: DOWNLOAD_READS {
        errorStrategy = 'retry'
        maxRetries    = 3
    }

    withName: DOWNLOAD_REFERENCE {
        errorStrategy = 'retry'
        maxRetries    = 3
    }

    withName: BWA_MEM {
        // Read group required by GATK downstream
        ext.args = { "-R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tPL:ILLUMINA\\tLB:lib1'" }
    }

    withName: SAMTOOLS_SORT {
        ext.prefix = { "${meta.id}.sorted" }
    }

    withName: 'BCFTOOLS_ANNOTATE.*' {
        ext.args   = '-Oz'
        ext.prefix = { "${meta.id}" }
    }

    withName: GATK4_MARKDUPLICATES {
        ext.prefix = { "${meta.id}.dedup.bam" }
        ext.args   = '--REMOVE_DUPLICATES false --CREATE_INDEX true'
    }

    withName: GATK4_BASERECALIBRATOR {
        ext.prefix = { "${meta.id}.recal" }
    }

    withName: GATK4_APPLYBQSR {
        ext.prefix = { "${meta.id}.recal" }
        ext.args   = '--create-output-bam-index true'
    }

    withName: GATK4_HAPLOTYPECALLER {
        ext.prefix = { "${meta.id}.raw" }
        ext.args   = { params.variant_interval ? "-L ${params.variant_interval}" : '' }
    }

    withName: GATK4_SELECTVARIANTS_SNP {
        ext.prefix = { "${meta.id}.raw_snps" }
        ext.args   = '--select-type-to-include SNP'
    }

    withName: GATK4_SELECTVARIANTS_INDEL {
        ext.prefix = { "${meta.id}.raw_indels" }
        ext.args   = '--select-type-to-include INDEL'
    }

    withName: GATK4_VARIANTFILTRATION_SNP {
        ext.prefix = { "${meta.id}.filtered_snps" }
        ext.args   = '--filter-expression "QD < 2.0" --filter-name "LowQD" --filter-expression "MQ < 40.0" --filter-name "LowMQ" --filter-expression "FS > 60.0" --filter-name "HighFS" --filter-expression "SOR > 3.0" --filter-name "HighSOR"'
    }

    withName: GATK4_VARIANTFILTRATION_INDEL {
        ext.prefix = { "${meta.id}.filtered_indels" }
        ext.args   = '--filter-expression "QD < 2.0" --filter-name "LowQD" --filter-expression "FS > 200.0" --filter-name "HighFS"'
    }

    withName: BCFTOOLS_VIEW_SNP {
        ext.prefix = { "${meta.id}.pass_snps" }
        ext.args   = '-f PASS -Oz --write-index=tbi'
    }

    withName: BCFTOOLS_VIEW_INDEL {
        ext.prefix = { "${meta.id}.pass_indels" }
        ext.args   = '-f PASS -Oz --write-index=tbi'
    }

    withName: BCFTOOLS_CONCAT {
        ext.prefix = { "${meta.id}.final" }
        ext.args   = '-a -Oz --write-index=tbi'
    }

    withName: BCFTOOLS_STATS {
        ext.prefix = { "${meta.id}.final" }
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
