/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Local / CI test config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Caps resources so the DAG can be stub-run or tested on a workstation without a
    container engine. Not for production use.

        nextflow run . -stub-run -c conf/local_test.config -profile test --input assets/samplesheet.csv
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus  : 2,
        memory: '6.GB',
        time  : '1.h'
    ]
}
